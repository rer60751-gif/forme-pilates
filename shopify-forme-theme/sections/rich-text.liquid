
<section class="forme-philosophy page-width" style="text-align: {{ section.settings.alignment }}; padding-top: {{ section.settings.padding }}px; padding-bottom: {{ section.settings.padding }}px;">
  {% if section.settings.eyebrow != blank %}
    <p>{{ section.settings.eyebrow | escape }}</p>
  {% endif %}

  <h2>{{ section.settings.heading | escape }}</h2>

  <div class="forme-philosophy__text">
    {{ section.settings.text }}
  </div>
</section>

<style>
  .forme-philosophy {
    max-width: 900px;
    color: {{ section.settings.text_color }};
  }

  .forme-philosophy h2 {
    color: {{ section.settings.heading_color }};
  }

  .forme-philosophy__text {
    max-width: 680px;
    margin: 0 auto;
  }

  .forme-philosophy__text p {
    margin-inline: auto;
  }
</style>

{% schema %}
{
  "name": "FORME philosophy",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Movement with intention."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe Pilates is more than exercise. It is a practice of presence, strength, and connection with yourself.</p>"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"},
        {"value": "right", "label": "Right"}
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Section spacing",
      "min": 20,
      "max": 120,
      "step": 10,
      "default": 70,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#64283B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#35272A"
    }
  ],
  "presets": [
    {"name": "FORME philosophy"}
  ]
}
{% endschema %}
