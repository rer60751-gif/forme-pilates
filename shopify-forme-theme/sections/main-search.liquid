
<section class="forme-search page-width">
  <header class="forme-search__header">
    <p class="forme-search__eyebrow">FIND YOUR FORME</p>
    <h1>{{ section.settings.heading | escape }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="forme-search__form">
      <label class="visually-hidden" for="FormeSearch">Search products</label>
      <input
        id="FormeSearch"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search products..."
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit">Search</button>
    </form>
  </header>

  {% if search.performed %}
    <p class="forme-search__count">
      {{ search.results_count }} result{% unless search.results_count == 1 %}s{% endunless %}
      for "{{ search.terms | escape }}"
    </p>

    {% paginate search.results by section.settings.results_per_page %}
      <div class="forme-search__grid">
        {% for item in search.results %}
          <article class="forme-search__card">
            <a href="{{ item.url }}" class="forme-search__image">
              {% if item.featured_image %}
                {{ item.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: item.title }}
              {% else %}
                <div class="forme-search__placeholder">FORME</div>
              {% endif %}
            </a>

            <div class="forme-search__info">
              <h2><a href="{{ item.url }}">{{ item.title | escape }}</a></h2>
              {% if item.object_type == 'product' %}
                <p>{{ item.price | money }}</p>
              {% elsif item.object_type == 'article' %}
                <p>Article</p>
              {% elsif item.object_type == 'page' %}
                <p>Page</p>
              {% endif %}
            </div>
          </article>
        {% else %}
          <p>No results found. Try another search.</p>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="forme-search__pagination" aria-label="Search pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}">Previous</a>
          {% endif %}
          <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}">Next</a>
          {% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  {% endif %}
</section>

<style>
  .forme-search {
    padding-top: 48px;
    padding-bottom: 64px;
  }

  .forme-search__header {
    max-width: 700px;
    text-align: center;
    margin: 0 auto 40px;
  }

  .forme-search__eyebrow {
    color: #64283b;
    font-size: 12px;
    letter-spacing: 2px;
  }

  .forme-search h1 {
    color: #64283b;
    font-size: clamp(32px, 5vw, 46px);
  }

  .forme-search__form {
    display: flex;
    gap: 10px;
    margin-top: 28px;
  }

  .forme-search__form input[type="search"] {
    flex: 1;
    min-width: 0;
    padding: 14px;
    border: 1px solid #d7c6c7;
    border-radius: 4px;
  }

  .forme-search__form button {
    padding: 14px 24px;
    border: 0;
    border-radius: 4px;
    background: #64283b;
    color: white;
    cursor: pointer;
  }

  .forme-search__count {
    margin-bottom: 24px;
  }

  .forme-search__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 20px;
  }

  .forme-search__image {
    display: block;
    background: #f6e9e7;
  }

  .forme-search__image img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
  }

  .forme-search__placeholder {
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    color: #64283b;
  }

  .forme-search__info h2 {
    font-size: 17px;
  }

  .forme-search__info a {
    color: #64283b;
    text-decoration: none;
  }

  .forme-search__pagination {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 40px;
  }

  @media (max-width: 749px) {
    .forme-search__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 12px;
    }
  }
</style>

{% schema %}
{
  "name": "FORME search",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Search FORME"
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    }
  ]
}
{% endschema %}
